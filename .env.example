# Copie para .env (não versionado) ou exporte no terminal. Nenhuma credencial é necessária:
# a coleta usa apenas a API pública e anônima do Apache Jira.

# Pasta do snapshot JSONL produzido por src/coleta/apache_jira_extract.py (≈ 21 GB de dados finais)
ALINE_JIRA_DATA_DIR=/caminho/para/data/apache_jira

# Cache compacto gerado por src/preparacao/01_projetar_base.py (≈ 650 MB; contém o sal de pseudonimização)
ALINE_CACHE_DIR=/caminho/para/data/cache_projecao

# Evidências agregadas por projeto (saídas de 03, 04, 05 e 06)
ALINE_EVIDENCIAS_DIR=/caminho/para/data/derivados/evidencias

# Bases analíticas linha a linha (saídas --bases de 05/06 e de 07); uso local, não versionar
ALINE_BASES_DIR=/caminho/para/data/derivados/bases

# Opcional: auditoria dos materiais de aula (não incluídos no repositório)
# ALINE_AULAS_DIR=/caminho/para/materiais_mba/Aulas
# ALINE_REDACT_NAMES=Nome Completo da Marca D'Água
